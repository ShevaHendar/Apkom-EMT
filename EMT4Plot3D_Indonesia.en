% Pertama kita definisikan tiga silinder, dan menyimpannya dalam string di Euler.
% 
% Fungsi povx() dan sebagainya hanya mengembalikan vektor [1,0,0], yang dapat digunakan sebagai gantinya.
>c1=povcylinder(-povx,povx,1,povlook(red)); ...
>c2=povcylinder(-povy,povy,1,povlook(yellow)); ...
>c3=povcylinder(-povz,povz,1,povlook(blue)); ...
% String tersebut berisi kode Povray, yang tidak perlu kita pahami pada tahap ini.
>c2
cylinder { <0,0,-1>, <0,0,1>, 1
 texture { pigment { color rgb <0.941176,0.941176,0.392157> }  } 
 finish { ambient 0.2 } 
 }
% Seperti yang Anda lihat, kita menambahkan tekstur pada objek dengan tiga warna berbeda.
