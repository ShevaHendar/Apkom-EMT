% * Contoh Lainnya
% 
% Anda dapat menemukan beberapa contoh lain untuk Povray di Euler pada
% file-file berikut.
% 
% Lihat: Examples/Dandelin Spheres
%% Lihat: Examples/Donat Math
%% Lihat: Examples/Trefoil Knot
%% Lihat: Examples/Optimization by Affine Scaling
% 
% * contoh penyelesaian masalah menggambar kurva/plot 3D
% Soal 1: Kalkulus – Visualisasi Permukaan Fungsi Dua Variabel
% (Paraboloid)Soal:Gambarkan grafik fungsi dua variabel
%% latex: f(x,y) = x^2 +  y^2
% %image% EMT4Plot3D_Indonesia-057.png
% // latex: f(x,y) = x^2 +  y^2
%% pada domain
%% latex: x, y \in [-2, 2].
% %image% EMT4Plot3D_Indonesia-058.png
% // latex: x, y \in [-2, 2].
%% Tampilkan kurva menggunakan skema warna spektral (spectral) agar
% perbedaan ketinggian z terlihat jelas.Tambahkan garis kontur (contour)
% otomatis dan atur banyaknya kisi (n=100) agar kurva tampil mulus.
>reset;
>plot3d("x^2+y^2", r=2, n=100,  ...
>>spectral, >contour, title="Paraboloid z = x^2 + y^2"):
 %image% EMT4Plot3D_Indonesia-059.png
% Penjelasan Kode:plot3d("x^2+y^2", ...) memplot fungsi dua variabel z =
% f(x,y).r=2 menentukan batas simetris rentang sumbu x dan y dari -2
% sampai 2.n=100 menentukan densitas subinterval pembentuk jaring-jaring
% permukaan (makin besar nilainya, permukaan makin mulus).>spectral
% menambahkan gradien warna berdasarkan Ketinggian nilai z (dari biru
% hingga merah).>contour menggambar garis-garis kontur ketinggian di
% atas permukaan objek.
% 
% Soal 2: Kalkulus/Geometri – Permukaan Parametrik 3D
% (Torus/Donat)Soal:Sebuah torus (objek berbentuk donat) didefinisikan
% secara parametrik oleh:
%% latex: x(u,v) = (3 + \cos u) \cos v ; y(u,v) = (3 + \cos u) \sin v
% %image% EMT4Plot3D_Indonesia-060.png
% // latex: x(u,v) = (3 + \cos u) \cos v ; y(u,v) = (3 + \cos u) \sin v
%% latex: z(u,v) = \sin u
% %image% EMT4Plot3D_Indonesia-061.png
% // latex: z(u,v) = \sin u
%% dengan
%% latex: u \in [0, 2\pi] ; v \in [0, 2\pi]
% %image% EMT4Plot3D_Indonesia-062.png
% // latex: u \in [0, 2\pi] ; v \in [0, 2\pi]
%% Gambarkan bentuk objek 3D tersebut menggunakan jaring-jaring kawat
% (wireframe) transparan bergradien warna.
>reset;
>u = linspace(0, 2*pi, 60);
>v = linspace(0, 2*pi, 60)';
>X = (3 + cos(u)) * cos(v);
>Y = (3 + cos(u)) * sin(v);
>Z = sin(u);
>plot3d(X, Y, Z, >hue, >wire, scale=1.5, title="Torus Parametrik"):
 %image% EMT4Plot3D_Indonesia-063.png
% Penjelasan Kode:
%%  (vektor baris) dan v (vektor kolom) membuat grid koordinat 2D untuk
% memparameterkan permukaan.
%% X, Y, dan Z dihitung menggunakan ekspresi perkalian matriks EMT
% sehingga menghasilkan matriks titik koordinat 3D.
%% >hue mengaktifkan pencahayaan/arsiran pada jaring.
%% >wire menampilkan struktur kawat (mesh/wireframe) penyusun permukaan.
%% scale=1.5 memperbesar ukuran visual objek pada ruang 3D.
% 
% Soal 3: Aljabar / Geometri Ruang – Permukaan Implisit 3D (Bola &
% Ellipsoid)
%% Soal:Gambarkan grafik implisit tiga variabel untuk persamaan 
%% latex: f(x,y,z) = x^2 + y^2 + 4z^2 - 1 = 0
% %image% EMT4Plot3D_Indonesia-064.png
% // latex: f(x,y,z) = x^2 + y^2 + 4z^2 - 1 = 0
%%  (Ellipsoid) pada rentang 
%% latex: r = 1.5
% %image% EMT4Plot3D_Indonesia-065.png
% // latex: r = 1.5
%% .Buatlah potongan permukaan sejajar bidang x-y, x-z, dan y-z
% menggunakan opsi implicit=7
>reset;
>plot3d("x^2 + y^2 + 4*z^2 - 1", r=1.5, implicit=7, zoom=3, title="Ellipsoid Implisit"):
 %image% EMT4Plot3D_Indonesia-066.png
% Penjelasan Kode:implicit=7 mengeksekusi gabungan irisan bidang (1 + 2
% + 4 = 7), yaitu potongan sejajar bidang y-z (implicit=1), x-z
% (implicit=2), dan x-y (implicit=4).r=1.5 menetapkan batas ruang kubus
% evaluasi [-1.5, 1.5] untuk sumbu x, y, dan z.zoom=3 memperbesar jarak
% pandang kamera ke objek.
% 
% 
% Soal 4: Kalkulus Vektor – Kurva Ruang 3D (Helix / Heliks
% Spiral)Soal:Suatu partikel bergerak mengikuti kurva heliks (spiral 3D)
% dengan persamaan parametrik:
%% latex: x(t) = \cos(t), \quad y(t) = \sin(t), \quad z(t) = \frac{t}{2\pi}
% %image% EMT4Plot3D_Indonesia-067.png
% // latex: x(t) = \cos(t), \quad y(t) = \sin(t), \quad z(t) = \frac{t}{2\pi}
%% untuk
%% latex: t \in [0, 6\pi].
% %image% EMT4Plot3D_Indonesia-068.png
% // latex: t \in [0, 6\pi].
%% Gambarkan lintasan kurva 3D tersebut dengan garis berwarna biru tebal.
>reset;
>t = linspace(0, 6*pi, 1000);
>x = cos(t);
>y = sin(t);
>z = t / (2*pi);
>plot3d(x, y, z, >wire, linewidth=3, wirecolor=blue, zoom=3, title="Heliks 3D"):
 %image% EMT4Plot3D_Indonesia-069.png
% Penjelasan Kode:t = linspace(0, 6*pi, 1000) membangkitkan 1000 titik
% sampel variabel parameter t.plot3d(x, y, z, >wire, ...) menerima tiga
% vektor 1D untuk menggambar kurva berupa garis tunggal di dalam ruang
% 3D.linewidth=3 mengatur ketebalan garis lintasan.wirecolor=blue
% mengubah warna garis heliks menjadi biru.
% 
% 
% Soal 5: Terapan / Pemodelan – Permukaan Benda PutarSoal:Sebuah kurva 
%% latex: z = f(x) = \sqrt{x}
% %image% EMT4Plot3D_Indonesia-070.png
% // latex: z = f(x) = \sqrt{x}
%%  untuk 
%% latex: x \in [0, 4]
% %image% EMT4Plot3D_Indonesia-071.png
% // latex: x \in [0, 4]
%%  diputar mengelilingi sumbu z (menggunakan opsi rotate=2). Gambarkan
% permukaan benda putar yang terbentuk (paraboloid terbalik/mangkok)
% dengan garis grid 
%% latex: 10 \times 10.
% %image% EMT4Plot3D_Indonesia-072.png
% // latex: 10 \times 10.
>reset;
>plot3d("sqrt(x)", a=0, b=4, rotate=2, grid=10, title="Benda Putar Mengelilingi Sumbu-Z"):
 %image% EMT4Plot3D_Indonesia-073.png
% Penjelasan Kode:plot3d("sqrt(x)", a=0, b=4, ...) mendefinisikan kurva
% 2D dasar
%% latex: y = \sqrt{x}
% %image% EMT4Plot3D_Indonesia-074.png
% // latex: y = \sqrt{x}
%% pada interval
%% latex: 0 \le x \le 4
% %image% EMT4Plot3D_Indonesia-075.png
% // latex: 0 \le x \le 4
%% .rotate=2 memutar kurva tersebut 360 derajat mengelilingi sumbu z
% untuk menghasilkan bangun ruang simetris putar. (Jika rotate=1 atau
% rotate=true, pemutaran dilakukan mengelilingi sumbu x).grid=10 membagi
% permukaan benda putar menjadi 10 segmen garis kisi horisontal dan
% vertikal.
>
