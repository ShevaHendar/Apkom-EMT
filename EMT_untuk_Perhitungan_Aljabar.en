% kuadratnya.
% 
% 3. Hitunglah ekspresi pecahan bertingkat berikut:
%% latex: \left(\frac{\frac{1}{7} + \frac{1}{8} + 2}{\frac{1}{3} + \frac{1}{2}}\right)^2 \pi
% %image% EMT_untuk_Perhitungan_Aljabar-006.png
% // latex: \left(\frac{\frac{1}{7} + \frac{1}{8} + 2}{\frac{1}{3} + \frac{1}{2}}\right)^2 \pi
> ((1/7+1/8+2)/(1/3+1/2))^2*pi
23.2671801626
% Penjelasan Output: EMT mendahulukan komputasi pembilang
%% latex: \frac{127}{56}
% %image% EMT_untuk_Perhitungan_Aljabar-007.png
% // latex: \frac{127}{56}
%% dan penyebut
%% latex: \frac{5}{6}
% %image% EMT_untuk_Perhitungan_Aljabar-008.png
% // latex: \frac{5}{6}
%% di dalam kurung, membaginya, menguadratkan hasilnya, dan mengalikannya
% dengan konstanta
% 
% 4. Ubahlah hasil penjumlahan pecahan
%% latex: \frac{1}{3} + \frac{1}{7}
% %image% EMT_untuk_Perhitungan_Aljabar-009.png
% // latex: \frac{1}{3} + \frac{1}{7}
%% ke dalam bentuk pecahan biasa desimal dan bentuk pecahan rasional.
> 1/3+1/7, fraction %
0.47619047619
10/21
% Penjelasan Output: Baris pertama menampilkan hasil penjumlahan berupa
% bilangan desimal titik mengambang. Operator fraction % merujuk pada
% hasil perhitungan terakhir (%) dan mengonversinya secara tepat menjadi
% bentuk pecahan murni 
%% latex: \frac{10}{21}[cite: 21].
% %image% EMT_untuk_Perhitungan_Aljabar-010.png
% // latex: \frac{10}{21}[cite: 21].
% 
% 5. Soal:Hitunglah perkalian bentuk aljabar berikut secara simbolik:
%% latex: (6x^{-3} + y^5)(-7x^2 - y^{-9})
% %image% EMT_untuk_Perhitungan_Aljabar-011.png
% // latex: (6x^{-3} + y^5)(-7x^2 - y^{-9})
>$&showev('expand((6*x^(-3)+y^5)*(-7*x^2-y^(-9))))
 %image% EMT_untuk_Perhitungan_Aljabar-012.png
% // latex: {\it expand}\left(\left(-\frac{1}{y^9}-7\,x^2\right)\,\left(y^5+  \frac{6}{x^3}\right)\right)=-7\,x^2\,y^5-\frac{1}{y^4}-\frac{6}{x^3  \,y^9}-\frac{42}{x}
% ** Perhitungan Matriks dan Sistem Aljabar LinearSoal
%% 2.1 (Determinan & Invers):
%% Tujuan: Menentukan determinan dan invers dari matriks
%% latex: A = \begin{pmatrix} 4 & 7 \\ 2 & 6 \end{pmatrix}.
% %image% EMT_untuk_Perhitungan_Aljabar-013.png
% // latex: A = \begin{pmatrix} 4 & 7 \\ 2 & 6 \end{pmatrix}.
%% Alasan Penggunaan Kode: determinant(A1) menghitung
%% latex: \vert{}A\vert{} = (4 \cdot 6) - (7 \cdot 2) = 10
% %image% EMT_untuk_Perhitungan_Aljabar-014.png
% // latex: \vert{}A\vert{} = (4 \cdot 6) - (7 \cdot 2) = 10
%% Perhitungan invers membutuhkan pembagian dengan determinan, yang
% dieksekusi otomatis secara eksak menggunakan invert(A1)
>$A1 := matrix([4, 7], [2, 6])
 %image% EMT_untuk_Perhitungan_Aljabar-015.png
% // latex: \begin{pmatrix}4 & 7 \\ 2 & 6 \\ \end{pmatrix}
>det(A1)
Variable or function A1 not found.
Error in:
det(A1) ...
      ^
>$invert(A1)
 %image% EMT_untuk_Perhitungan_Aljabar-016.png
% // latex: \begin{pmatrix}\frac{3}{5} & -\frac{7}{10} \\ -\frac{1}{5} & \frac{  2}{5} \\ \end{pmatrix}
% Soal 2.2 (Perkalian Matriks 3x3):
%% Tujuan: Mengalikan dua matriks berukuran 3x3 
%% latex: A_2 \cdot B_2.
% %image% EMT_untuk_Perhitungan_Aljabar-017.png
% // latex: A_2 \cdot B_2.
%% Alasan Penggunaan Kode: Operator perkalian matriks pada moda Maxima di
% EMT adalah titik (.), bukan asterisk (*). Penggunaan . memastikan
% bahwa yang dilakukan adalah perkalian matriks (baris kali kolom),
% bukan perkalian element-wise.
>$A2 := matrix([1, 2, 0], [3, -1, 4], [0, 5, 2])
 %image% EMT_untuk_Perhitungan_Aljabar-018.png
% // latex: \begin{pmatrix}1 & 2 & 0 \\ 3 & -1 & 4 \\ 0 & 5 & 2 \\   \end{pmatrix}
>$B2 = matrix([2, 0, 1], [-1, 3, 0], [4, 1, -2])
 %image% EMT_untuk_Perhitungan_Aljabar-019.png
% // latex: {\it B_2}=\begin{pmatrix}2 & 0 & 1 \\ -1 & 3 & 0 \\ 4 & 1 & -2 \\   \end{pmatrix}
>$A2 . B2
 %image% EMT_untuk_Perhitungan_Aljabar-020.png
% // latex: \begin{pmatrix}1 & 2 & 0 \\ 3 & -1 & 4 \\ 0 & 5 & 2 \\   \end{pmatrix}\cdot {\it B_2}
% Soal 2.3 (Uji Simetri Matriks):
%% Tujuan: Memeriksa apakah matriks A_3 simetris 
%% latex: A_3 = A_3^T.
% %image% EMT_untuk_Perhitungan_Aljabar-021.png
% // latex: A_3 = A_3^T.
%% Alasan Penggunaan Kode: transpose(A3) membalik baris menjadi kolom.
% Fungsi is(A3 = transpose(A3)) mengevaluasi kesamaan struktur tersebut
% dan mengembalikan nilai boolean (true/false).
>$A3 := matrix([2, 5, -1], [5, 4, 3], [-1, 3, 0])
 %image% EMT_untuk_Perhitungan_Aljabar-022.png
% // latex: \begin{pmatrix}2 & 5 & -1 \\ 5 & 4 & 3 \\ -1 & 3 & 0 \\   \end{pmatrix}
>$A3 = transpose(A3)
 %image% EMT_untuk_Perhitungan_Aljabar-023.png
% // latex: \begin{pmatrix}2 & 5 & -1 \\ 5 & 4 & 3 \\ -1 & 3 & 0 \\   \end{pmatrix}=\begin{pmatrix}2 & 5 & -1 \\ 5 & 4 & 3 \\ -1 & 3 & 0   \\ \end{pmatrix}
% Soal 2.4 (Sistem Persamaan Linear 3 Variabel):
%% Tujuan: Mencari solusi x, y, z dari sistem linear 3 variabel.
%% Alasan Penggunaan Kode: Perhitungan manual dengan eliminasi Gauss
% rawan kesalahan tanda. Fungsi lsolve(persamaan, variabel)
% menyelesaikan SPL secara aljabar eksak menggunakan analisis matriks
% secara otomatis.
>&eqs2 := [2*x + y - z = 8, -3*x - y + 2*z = -11, -2*x + y + 2*z = -3]

       [- z + y + 2 x = 8, 2 z - y - 3 x = - 11, 2 z + y - 2 x = - 3]

>&solve([2*x + y - z = 8, -3*x - y + 2*z = -11, -2*x + y + 2*z = -3], [x, y, z])

                      [[x = 2, y = 3, z = - 1]]

% Soal 2.5 (Nilai Eigen dan Vektor Eigen):
%% Tujuan: Menentukan nilai eigen 
%% latex: \lambda 
% %image% EMT_untuk_Perhitungan_Aljabar-024.png
% // latex: \lambda 
%% dan vektor eigen dari matriks A_5.
%% Alasan Penggunaan Kode: eigenvectors(A5) menyelesaikan persamaan
% karakteristik 
%% latex: \det(A - \lambda I) = 0 
% %image% EMT_untuk_Perhitungan_Aljabar-025.png
% // latex: \det(A - \lambda I) = 0 
%% dan mengembalikan daftar nilai eigen beserta multiplisitas dan vektor
% eigennya sekaligus.
>&A5 := matrix([5, 2],[2, 2])

                               [ 5  2 ]
                               [      ]
                               [ 2  2 ]

>&eigenvectors(A5)

                                       1
              [[[6, 1], [1, 1]], [[[1, -]], [[1, - 2]]]]
                                       2

% ** Penyelesaian Persamaan Kuadrat Secara Simbolik
%% Soal 3.1 (Akar Persamaan Kuadrat Standar):
%% Tujuan: Menyelesaikan 
%% latex: x^2 - 7x + 12 = 0.
% %image% EMT_untuk_Perhitungan_Aljabar-026.png
% // latex: x^2 - 7x + 12 = 0.
%% Alasan Penggunaan Kode: Fungsi solve(persamaan, x) menganalisis
% suku-suku persamaan kuadrat dan memberikan akar-akar aljabar eksak 
%% latex: x = 3 ; x = 4.
% %image% EMT_untuk_Perhitungan_Aljabar-027.png
% // latex: x = 3 ; x = 4.
>$&sol3_1 := solve(x^2 - 7*x + 12 = 0, x)
 %image% EMT_untuk_Perhitungan_Aljabar-028.png
% // latex: \left[ x=3 , x=4 \right] 
% Soal 3.2 (Persamaan Kuadrat Berparameter):
%% Tujuan: Menyelesaikan 
%% latex: ax^2 + 4x + 1 = 0 
% %image% EMT_untuk_Perhitungan_Aljabar-029.png
% // latex: ax^2 + 4x + 1 = 0 
%% dalam bentuk parameter a.
%% Alasan Penggunaan Kode: Maxima mendukung komputasi simbolik. solve
% dapat memperlakukan a sebagai konstanta simbolik dan mengekspresikan x
% menggunakan rumus kuadrat (rumus ABC) dalam variabel a.
>$&

% 3.3 (Akar Kompleks/Imajiner):
%% Tujuan: Menyelesaikan 
%% latex: 2x^2 + 3x + 5 = 0 
% %image% EMT_untuk_Perhitungan_Aljabar-030.png
% // latex: 2x^2 + 3x + 5 = 0 
%% yang memiliki diskriminan negatif.
%% Alasan Penggunaan Kode: solve secara otomatis menangani nilai
% diskriminan D < 0 dan mengembalikan jawaban dalam unit imajiner i
% tanpa menghasilkan kesalahan runtime.
% 
>$&
sol3_3 := solve(2*x^2 + 3*x + 5 = 0, x) 
 %image% EMT_untuk_Perhitungan_Aljabar-031.png
% // latex: \left[ x=\frac{-\sqrt{31}\,i-3}{4} , x=\frac{\sqrt{31}\,i-3}{4}   \right] 
% 3.4 (Penyederhanaan Persamaan Kuadrat):
%% Tujuan: Menyelesaikan 
%% latex: (x - 2)^2 + 3(x + 1) = 10.
% %image% EMT_untuk_Perhitungan_Aljabar-032.png
% // latex: (x - 2)^2 + 3(x + 1) = 10.
%% Alasan Penggunaan Kode: Pengguna tidak perlu menguraikan dan
% menyederhanakan bentuk kuadrat secara manual. Maxima secara otomatis
% memperluas (expand) dan menyederhanakan suku-suku tersebut sebelum
% mengeksekusi pencarian akar.
% 
>$&eq3_4 := (x - 2)^2 + 3*(x + 1) = 10
 %image% EMT_untuk_Perhitungan_Aljabar-033.png
% // latex: 3\,\left(x+1\right)+\left(x-2\right)^2=10
>$&sol3_4 := solve(eq3_4, x) 
 %image% EMT_untuk_Perhitungan_Aljabar-034.png
% // latex: \left[ x=\frac{1-\sqrt{13}}{2} , x=\frac{\sqrt{13}+1}{2} \right] 
>$&eq3_5 := 3*x^2 - 5*x + 2
 %image% EMT_untuk_Perhitungan_Aljabar-035.png
% // latex: 3\,x^2-5\,x+2
% Soal 3.5 (Perhitungan Diskriminan):Tujuan: Menentukan nilai
%% latex: D = b^2 - 4ac
% %image% EMT_untuk_Perhitungan_Aljabar-036.png
% // latex: D = b^2 - 4ac
%% dari
%% latex: 3x^2 - 5x + 2 = 0.
% %image% EMT_untuk_Perhitungan_Aljabar-037.png
% // latex: 3x^2 - 5x + 2 = 0.
%% Alasan Penggunaan Kode: Fungsi coeff(ekspresi, variabel, pangkat)
% digunakan untuk mengambil koefisien a, b, c secara dinamis dari bentuk
% polinomial tanpa perlu mengekstrak angka secara manual.
>$&disc3_5 := coeff(eq3_5, x, 1)^2 - 4*coeff(eq3_5, x, 2)*coeff(eq3_5, x, 0)
 %image% EMT_untuk_Perhitungan_Aljabar-038.png
% // latex: 1
% NAMA Sheva hendra syahputra
%% NIM 25030630099
>
